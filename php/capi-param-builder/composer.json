{
  "name": "facebook/capi-param-builder-php",
  "version": "1.3.2",
  "description": "Parameter builder SDK for Conversion API events",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^8.5"
  },
  "type": "library",
  "autoload": {
    "psr-4": {
      "FacebookAds\\": "src/"
    },
    "classmap": [
      "src/model/",
      "src/util/",
      "src/piiUtil/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "FacebookAds\\": "tests/"
    }
  }
}
